<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <!-- 气压表总数配置 -->
        <!-- 当前需求：72个，可根据实际情况调整 -->
        <add key="TotalBarometers" value="72" />
        
        <!-- IO输入总数配置 -->
        <!-- 当前现场：80路（2×DI50N-S + 1×DI40N-S），前72路对应显耀IO表，剩余预留 -->
        <add key="TotalInputs" value="80" />
        
        <!-- IO输出总数配置 -->
        <!-- 当前现场：160路（5×DQ50P-S），其中144路对应显耀IO表，剩余预留 -->
        <add key="TotalOutputs" value="160" />
        
        <!-- 数据采集间隔（毫秒） -->
        <add key="CollectInterval" value="1000" />
        
        <!-- 主视图每行显示的气压表数量 -->
        <add key="PanelColumns" value="8" />
        
        <!-- 主视图每列显示的气压表数量 -->
        <add key="PanelRows" value="9" />
        
        <!-- 通信端口配置 -->
        <!-- 以 ModbusRtuBarometerTest Demo 实测为准：波特率 19200 -->
        <add key="PortName" value="COM1" />
        <add key="BaudRate" value="19200" />
        <add key="DataBits" value="8" />
        <add key="StopBits" value="1" />
        <add key="Parity" value="None" />

        <add key="UseMockCommunication" value="false" />
        <add key="SerialReadTimeoutMs" value="1000" />
        <add key="SerialWriteTimeoutMs" value="1000" />
        <add key="TcpSendTimeoutMs" value="3000" />
        <add key="TcpReceiveTimeoutMs" value="3000" />

        <add key="InvertInputs" value="false" />
        <add key="InvertOutputs" value="false" />

        <add key="IoUnitId" value="1" />
        <add key="IoInputRegisterStartAddress" value="0x1000" />
        <add key="IoOutputRegisterStartAddress" value="0x2000" />

        <!-- 以 ModbusRtuBarometerTest Demo 实测为准：压力走 Input Register 0x0001（0x0002 为小数位） -->
        <add key="BarometerPressureRegisterAddress" value="0x0001" />
        <add key="BarometerDefaultDecimalPlaces" value="1" />
        <add key="BarometerPressureScale" value="1" />

        <add key="AlarmPressureThresholdPa" value="-95000" />
        <add key="AlarmWhenPressureHigherThanThreshold" value="true" />
        
        <!-- GX-CL140 默认 IP -->
        <add key="PlcAddress" value="192.168.1.20" />

        <!-- PLC通讯端口（修复 L3：补全配置项，默认 502 为 Modbus TCP 标准端口） -->
        <add key="PlcPort" value="502" />
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
