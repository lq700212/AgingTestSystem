<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <!-- 气压表总数配置 -->
        <!-- 当前需求：72个，可根据实际情况调整 -->
        <add key="TotalBarometers" value="72" />
        
        <!-- IO输入总数配置 -->
        <!-- 当前需求：72个 -->
        <add key="TotalInputs" value="72" />
        
        <!-- IO输出总数配置 -->
        <!-- 当前需求：144个 -->
        <add key="TotalOutputs" value="144" />
        
        <!-- 数据采集间隔（毫秒） -->
        <add key="CollectInterval" value="1000" />
        
        <!-- 主视图每行显示的气压表数量 -->
        <add key="PanelColumns" value="9" />
        
        <!-- 主视图每列显示的气压表数量 -->
        <add key="PanelRows" value="8" />
        
        <!-- 通信端口配置 -->
        <add key="PortName" value="COM1" />
        <add key="BaudRate" value="9600" />
        <add key="DataBits" value="8" />
        <add key="StopBits" value="1" />
        <add key="Parity" value="None" />

        <add key="UseMockCommunication" value="true" />
        <add key="SerialReadTimeoutMs" value="1000" />
        <add key="SerialWriteTimeoutMs" value="1000" />
        <add key="TcpSendTimeoutMs" value="3000" />
        <add key="TcpReceiveTimeoutMs" value="3000" />

        <add key="IoUnitId" value="1" />
        <add key="IoInputRegisterStartAddress" value="0x1000" />
        <add key="IoOutputRegisterStartAddress" value="0x2000" />

        <add key="BarometerPressureRegisterAddress" value="0x0010" />
        <add key="BarometerPressureScale" value="1" />

        <add key="AlarmPressureThresholdPa" value="-95000" />
        <add key="AlarmWhenPressureHigherThanThreshold" value="true" />
        
        <!-- PLC连接地址（预留，待确认协议） -->
        <add key="PlcAddress" value="192.168.1.100" />

        <!-- PLC通讯端口（修复 L3：补全配置项，默认 502 为 Modbus TCP 标准端口） -->
        <add key="PlcPort" value="502" />
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
