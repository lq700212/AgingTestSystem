<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <!-- 气压表总数配置 -->
        <!-- 当前需求：72个，可根据实际情况调整 -->
        <add key="TotalBarometers" value="72" />
        
        <!-- IO输入总数配置 -->
        <!-- 当前现场：80路（2×DI50N-S + 1×DI40N-S），前72路对应IO分配表，剩余预留 -->
        <add key="TotalInputs" value="80" />
        
        <!-- IO输出总数配置 -->
        <!-- 当前现场：160路（5×DQ50P-S），其中144路对应IO分配表，剩余预留 -->
        <add key="TotalOutputs" value="160" />
        
        <!-- 数据采集间隔（毫秒） -->
        <add key="CollectInterval" value="1000" />
        
        <!-- 主视图每行显示的气压表数量 -->
        <add key="PanelColumns" value="8" />
        
        <!-- 主视图每列显示的气压表数量 -->
        <add key="PanelRows" value="9" />
        
        <!-- 通信端口配置 -->
        <!-- 以 ModbusRtuBarometerTest Demo 实测为准：波特率 19200 -->
        <!-- V1.16：程序启动时若配置端口不存在，会自动识别 CH340 串口（气压表 RS485 适配器），
             因此这里填的是"当前实测端口"（COM9），换 USB 口/换电脑时无需改配置。
             连接成功后程序会把实际端口写入 exe 同目录的 BarometerPort.cache，
             下次启动优先用缓存端口（省去重新搜索）；缓存端口失效（设备被拔/换 USB 口）再自动重新识别 -->
        <add key="PortName" value="COM9" />
        <add key="BaudRate" value="19200" />
        <add key="DataBits" value="8" />
        <add key="StopBits" value="1" />
        <add key="Parity" value="None" />

        <add key="UseMockCommunication" value="false" />
        <add key="SerialReadTimeoutMs" value="1000" />
        <add key="SerialWriteTimeoutMs" value="1000" />
        <add key="TcpSendTimeoutMs" value="3000" />
        <add key="TcpReceiveTimeoutMs" value="3000" />

        <add key="InvertInputs" value="false" />
        <add key="InvertOutputs" value="false" />

        <add key="IoUnitId" value="1" />
        <add key="IoInputRegisterStartAddress" value="0x1000" />
        <add key="IoOutputRegisterStartAddress" value="0x2000" />

        <!-- ===================== IO 输出备用通道映射（现场 DQ 通道烧毁时使用） ===================== -->
        <!-- 总开关：false=不启用（默认，多数工作台正常）；true=启用下面的通道重定向 -->
        <add key="IoBackupChannelMappingEnabled" value="false" />
        <!-- 映射表（仅在开关为 true 时生效）：源寄存器@源通道->目标寄存器@目标通道，多组用分号(;)分隔。
              寄存器与通道均为十六进制（寄存器 0x0000~0xFFFF，通道 0x00~0x0F，0x00=第1路/bit0），
             与设置界面显示完全一致（所见即所得），程序内部自动把通道转成十进制位号运算。
             示例含义：0x2000 的 0x00 通道烧毁 → 改写到 0x2009 的 0x01 通道；
                       0x2000 的 0x01 通道烧毁 → 改写到 0x2009 的 0x02 通道；
                       0x2008 的 0x00 通道烧毁 → 改写到 0x2009 的 0x08 通道 -->
        <add key="IoBackupChannelMappings" value="0x2000@0x00->0x2009@0x01;0x2000@0x01->0x2009@0x02;0x2008@0x00->0x2009@0x08" />

        <!-- 以 ModbusRtuBarometerTest Demo 实测为准：压力走 Input Register 0x0001 -->
        <!-- 注意：0x0002（小数位）寄存器现场实测不可靠（72台中47台返回0，仪表实际1位小数），
             压力读取与阈值写入统一使用下面的 BarometerDefaultDecimalPlaces，不读 0x0002 -->
        <add key="BarometerPressureRegisterAddress" value="0x0001" />
        <!-- 气压表小数位（务必与仪表实际小数位一致！）：
             换气压表/换型号时，如果新表小数位不同，改这里一个值即可（程序自动对压力读取和阈值写入同时生效）。
             当前现场气压表为固定 1 位小数 -->
        <add key="BarometerDefaultDecimalPlaces" value="1" />
        <!-- 压力缩放系数（读数 × 该值；换不同量程/单位的气压表时按需调整） -->
        <add key="BarometerPressureScale" value="1" />

        <!-- 报警压力阈值（单位：kPa，与气压表读数同单位；公共参数窗口保存负压值时实时同步此值） -->
        <add key="AlarmPressureThresholdKPa" value="-5" />
        <add key="AlarmWhenPressureHigherThanThreshold" value="true" />
        
        <!-- GX-CL140 默认 IP -->
        <add key="PlcAddress" value="192.168.1.20" />

        <!-- PLC通讯端口（修复 L3：补全配置项，默认 502 为 Modbus TCP 标准端口） -->
        <add key="PlcPort" value="502" />

        <!-- ===================== 冷却送风机配置（V1.10 新增） ===================== -->
        <!-- 送风机是否启用（true=接入，false=跳过。送风机是可选设备，连接失败不影响整机启动） -->
        <add key="FanEnabled" value="true" />
        <!-- 送风机控制屏 IP（以 ModbusTCPFanControllerTest Demo 实测为准） -->
        <add key="FanIpAddress" value="192.168.1.220" />
        <!-- 送风机 IP 自动识别开关：true=连接时按顺序尝试下面的候选 IP，第一个连上的即为设备地址（现场换控制器不用改配置）；false=只连 FanIpAddress -->
        <add key="FanAutoDetectEnabled" value="true" />
        <!-- 送风机候选 IP 列表（逗号/分号分隔，仅 FanAutoDetectEnabled=true 时生效；FanIpAddress 始终优先尝试） -->
        <add key="FanIpCandidates" value="192.168.1.220,192.168.1.221,192.168.1.222" />
        <!-- 送风机通讯端口（实测默认 50000，非标准 502） -->
        <add key="FanPort" value="50000" />
        <!-- 送风机从站地址 -->
        <add key="FanUnitId" value="1" />
        <!-- 送风机通讯超时（毫秒），同时用于连接/读写超时 -->
        <add key="FanTimeoutMs" value="3000" />

        <!-- ===================== 老化测试业务参数（V1.10 新增） ===================== -->
        <!-- 真空建立确认超时（毫秒）：开阀后多久压力必须进入正常区间，超时按真空建立失败报警 -->
        <add key="VacuumConfirmTimeoutMs" value="15000" />
        <!-- 通讯故障报警阈值：某台气压表连续读取失败 N 次 → 按失联报警（关阀+断电+标故障） -->
        <add key="CommunicationLossAlarmCount" value="3" />
        <!-- 老化测试最大时长（秒），0 = 不限时长（手动停止）；设置 &gt;0 则到时自动停止该台 -->
        <add key="MaxTestDurationSeconds" value="0" />
        <!-- 是否把气压表报警触点(DI)并入报警判定：默认 false（仅显示）；现场确认触点电平后置 true -->
        <add key="UseDiAlarmContact" value="false" />
        <!-- 送风机温度告警上限(°C)，0 = 不启用；超过上限时界面红色提示并记日志 -->
        <add key="FanTempAlarmLimitC" value="0" />
        <!-- 超温全线联停开关（V1.66）：false=现状（超温只记日志不停机）；true=送风机温度超过上限时
             自动停止全部在测工位（关阀+断电，边沿触发一次，回温后自动复位）。烧屏架72台24h点亮，
             超温是火灾级风险；现场确认超温动作（问题清单Q16）后把本开关置 true 即可生效 -->
        <add key="FanTempShutdownEnabled" value="false" />

        <!-- ===================== 工艺策略（V1.67 新增：一期 L2 策略层） ===================== -->
        <!-- 7 个待确认点全部可配：客户 A 要拦截、客户 B 要放行，出差改配置不动代码。
             缺省值 = V1.67 之前的行为（不配=和以前一模一样，老项目零变化）。
             策略是跟项目的：Projects/<项目>/Policy.json 优先级高于这里；
             这里只做机器级缺省（比如从没进过设置界面的老机器）。
             系统设置"工艺策略"分类集中编辑（下拉中文，存英文名，大小写无所谓，写错兜底缺省）。 -->
        <!-- Q13前半：0时长启动（Warn=只警告现状 / Block=硬拦截） -->
        <add key="ZeroDurationPolicy" value="Warn" />
        <!-- Q13后半：空SN启动（Warn=只警告现状 / Block=硬拦截） -->
        <add key="EmptySnPolicy" value="Warn" />
        <!-- Q16前半：送风机断连（LogOnly=只提示照跑现状 / BlockStart=阻断启动；只管启动那一下） -->
        <add key="FanDisconnectPolicy" value="LogOnly" />
        <!-- Q19：真空失败责任（ProductFail=记FAIL现状 / FixtureAlarm=记装夹异常可重测） -->
        <add key="VacuumFailKind" value="ProductFail" />
        <!-- Q22：完成判定口径（AutoPass=到时自动PASS现状 / PendingReview=待判定+下料人工录） -->
        <add key="CompletionJudgePolicy" value="AutoPass" />
        <!-- Q21①：断电恢复（RestartFull=整台重测现状 / ResumeRemaining=重抽真空+补足剩余时长） -->
        <add key="PowerLossPolicy" value="RestartFull" />
        <!-- Q11：老化中失压（StopOnLoss=停机报警现状 / KeepRunning=只记事件继续老化；只管Aging阶段） -->
        <add key="AgingPressureLossPolicy" value="StopOnLoss" />
        <!-- Q6/Q15：到时完成动作（PowerOffOnly=只下电关阀现状 / 带Beep=蜂鸣 / 带Vent=破空泄压需配点位） -->
        <add key="CompletionAction" value="PowerOffOnly" />
        <!-- 破空阀DO输出点内部编号（如225），0=未配置（默认，选了泄压也只记日志不写DO，防写坏通道） -->
        <add key="VentValveDoPoint" value="0" />
        <!-- 当前项目指针（机器级：这台工控机当前跑哪个项目；"项目切换"菜单改，改后重启生效） -->
        <add key="ActiveProject" value="Default" />

        <!-- ===================== 扫码枪配置（V1.16 新增，参考 SerialScannerTest Demo） ===================== -->
        <!-- 是否启用扫码枪：true=启动时自动识别并连接扫码枪（串口读码）；false=不连接（现场没装扫码枪时用） -->
        <add key="ScannerEnabled" value="true" />
        <!-- 固定串口（如 COM10）：留空=按 ScannerDeviceKeyword 自动识别；填了则优先用固定端口 -->
        <add key="ScannerPort" value="" />
        <!-- 设备识别关键词（设备管理器里显示的名称关键字，当前为 Honeywell Xenon 1902） -->
        <add key="ScannerDeviceKeyword" value="Xenon 1902" />
        <!-- 串口参数（以 SerialScannerTest Demo 实测为准：115200/8/N/1） -->
        <add key="ScannerBaudRate" value="115200" />
        <add key="ScannerDataBits" value="8" />
        <add key="ScannerStopBits" value="1" />
        <add key="ScannerParity" value="None" />
        <!-- 心跳调试日志（V1.16.3）：true=心跳每个周期把端口搜索结果打到 LOG，排查"断连识别不到"用 -->
        <add key="ScannerDebugLog" value="true" />

        <!-- ===================== 界面主题（V1.60 新增） ===================== -->
        <!-- 深色/浅色模式：Light=浅色（默认，跟现行界面一致）/ Dark=深色（深灰底浅字，适合暗光车间）。
             用主界面菜单栏"关于"右侧的【深色模式】按钮切换，程序自动保存，下次启动接着用。
             手写错（大小写无所谓，写错按 Light 处理），不影响启动。 -->
        <add key="AppTheme" value="Light" />
    </appSettings>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <runtime>
        <!-- 【V1.55 高DPI适配】.NET Framework 4.7+ 的 WinForms PerMonitorV2 运行时开关。
             与 app.manifest 里的 PerMonitorV2 声明配套：manifest 告诉系统"进程感知每显示器DPI"，
             本开关让 WinForms 在 DPI 变化时自动缩放窗体与标准控件布局（AutoScaleMode.Font 的窗体才能被正确放大）。
             缺失时 WinForms 可能忽略 DPI 变化，导致高分辨率屏幕上标准控件不放大、界面显示不正常。 -->
        <AppContextSwitchOverrides value="Switch.System.Windows.Forms.DpiAwareness=PerMonitorV2" />
    </runtime>
</configuration>
