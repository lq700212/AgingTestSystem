<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <appSettings>
        <!-- 送风机候选 IP 列表（自动识别）：连接时按顺序逐个尝试，第一个连上的即为设备真实地址。
             配置多少个就能识别多少个（数量不限）；支持逗号 / 分号 / 中英文标点分隔。
             界面输入的 IP 会排在最前面优先尝试。 -->
        <add key="FanIpCandidates" value="192.168.1.220,192.168.1.221,192.168.1.222" />
    </appSettings>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
</configuration>
