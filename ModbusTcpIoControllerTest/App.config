<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup>
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
    </startup>
    <!-- ===================== IO 输出备用通道映射（现场 DQ 通道烧毁时使用） ===================== -->
    <!-- 总开关：false=不启用（默认，多数工作台正常）；true=启用下面的通道重定向 -->
    <appSettings>
        <add key="IoBackupChannelMappingEnabled" value="false" />
        <!-- 映射表（仅在开关为 true 时生效）：源寄存器@源通道->目标寄存器@目标通道，多组用分号(;)分隔。
             寄存器为十六进制（可带 0x），通道为 0~15（0=第1路/bit0）。
             示例含义：0x2000 的 00 通道烧毁 → 改写到 0x2009 的 10 通道；
                       0x2008 的 00 通道烧毁 → 改写到 0x2009 的 11 通道 -->
        <add key="IoBackupChannelMappings" value="0x2000@0->0x2009@10;0x2008@0->0x2009@11" />
    </appSettings>
</configuration>