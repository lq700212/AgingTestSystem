# ============================================================
# .gitignore for C# / .NET Framework WinForms projects
# 忽略不需要提交到 git 的文件和目录
# ============================================================

# ===== Visual Studio 临时文件 =====
## VS 工作区缓存目录（含 .suo 等用户私有设置）
.vs/

# ===== 编译输出目录 =====
## 编译中间文件和最终输出
bin/
obj/

# ===== 用户私有文件 =====
## 用户级解决方案选项（包含个人断点、窗口布局等）
*.user
*.suo

# ===== Visual Studio 调试临时文件 =====
*.pdb
*.vshost.exe
*.vshost.exe.config
*.vshost.exe.manifest

# ===== Windows 系统文件 =====
## 缩略图缓存
Thumbs.db
## 桌面.ini 文件
desktop.ini

# ===== 其他临时文件 =====
*.log
*.tmp
*.bak
*.cache

# ===== NuGet 包目录（如果使用 NuGet） =====
packages/

# ===== 运行时用户数据（密码为 PBKDF2 哈希，明文不落盘，程序首次运行自动生成） =====
Users.json

# 记住密码数据（含 base64 密码，勾选"记住密码"时自动生成）
RememberedLogin.json

# 在测任务快照（断电恢复用，V1.59 起程序运行时自动生成/删除）
TestSession.json

# ===== 软件授权运行时文件（V1.83 起：跟机器，绝不入库） =====
# License.lic：客户工控机上的授权文件（RSA 签名，一机一证），签发后拷机导入
License.lic
# License.trial：试用期/上次运行时间戳（DPAPI 保护，防删库重置试用，删了按首次运行重计）
License.trial
# 签发端私钥（只在公司保管，丢了=无法再签发；公钥嵌在 LicenseManager.cs 里随产品发布）
license_private.xml
# 签发工具本地编译产物（csc 在源码目录直出 exe，防手滑入库；工具源码 .cs 照常入库）
tools/LicenseKeyGen/*.exe
